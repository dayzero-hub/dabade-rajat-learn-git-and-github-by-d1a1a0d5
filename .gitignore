# Operating-system files that are about your machine, not the project
.DS_Store
Thumbs.db

# Editor settings — yours, not the team's
.vscode/
.idea/

# node_modules is generated by npm from package.json and can be hundreds of
# megabytes; committing it bloats the repo, and anyone who clones can rebuild
# it with `npm install`
node_modules/

# .env holds secrets like API keys; once a secret is pushed to GitHub it is
# public immediately and stays in the repo's history even after the file is
# deleted
.env
